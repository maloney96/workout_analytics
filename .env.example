# Hevy API key — Hevy Pro only, generate at https://hevy.com/settings?developer
HEVY_API_KEY=

# Local timezone used to derive workout_date_local and workout_hour_local from UTC timestamps.
# Load-bearing: the time-of-day analysis is meaningless without it.
LOCAL_TZ=America/Los_Angeles

# Nominal bodyweight in kg, used only to give bodyweight movements (pull-ups, dips) a
# comparable load. Held constant on purpose so progression isn't confounded by weight change.
ASSUMED_BODYWEIGHT_KG=80

# Paths — leave unset. config.py defaults to ./data/ relative to the repo, which is
# what you want for local runs. Docker Compose and the GitHub Actions workflow set
# these explicitly to their own container/runner paths.
# DUCKDB_PATH=
# BRONZE_PATH=
